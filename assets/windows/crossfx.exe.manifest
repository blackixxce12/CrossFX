<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest crates/crossfx-app/build.rs embeds in crossfx.exe (RT_MANIFEST 1).

  Without one, Windows runs the program in its compatibility defaults: DPI-unaware, so the
  window is bitmap-stretched and blurry on any display above 100 %; with comctl32 version 5, so
  message boxes and dialogs are drawn unthemed; and told it runs on Windows 8, as an application
  written before Windows 10 is.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Common Controls 6: the themed controls of the dialogs rfd opens and of the message
       boxes. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <!-- asInvoker: the user's own rights. CrossFX changes nothing that needs an administrator, and
       an elevated audio application would be one that starts with a UAC prompt at every login. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Windows 10 and Windows 11, which share this id: the systems CrossFX supports, and the
       ones whose real version the program is then told. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <!-- Per-monitor DPI awareness, version 2: the window is rendered at each display's own scale and
       re-rendered when it moves to another, with the non-client area scaled by Windows. winit asks
       for the same at run time; declaring it here is what Microsoft recommends, and it is in force
       before the first window exists. dpiAware is the fallback Windows 8.1 and early Windows 10
       read when they do not know dpiAwareness. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
