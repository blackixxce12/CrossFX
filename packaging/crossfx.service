[Unit]
Description=CrossFX audio enhancer
Documentation=man:crossfx(1)
# Ordering only: CrossFX survives PipeWire going away and reconnects on its own, so a hard
# dependency would take the application down with a daemon restart it is built to ride out.
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
# The name the instance owns on the session bus, and the one
# packaging/io.github.blackixxce12.CrossFX.service activates this unit for. Type stays simple:
# without a session bus CrossFX runs socket-only, and a unit of Type=dbus would call that a
# failed start.
BusName=io.github.blackixxce12.CrossFX
# --activated starts hidden as --hide does, and exits without forwarding anything when CrossFX is
# running already: a bus activation that lands while a launcher-started instance is still starting
# must not hide the window that instance just opened.
ExecStart=/usr/bin/crossfx --activated
# Hands the session default back before exiting; SIGTERM does the same, so this is belt and
# braces for a stop that arrives while the window is being recreated. Guarded: systemd runs the
# stop commands after every successful start, also when the main process has exited on its own,
# and then leaves $MAINPID unset. That is what an --activated start does when CrossFX runs already
# (from a launcher, say), and an unguarded --quit would reach and quit that instance instead.
ExecStop=-/bin/sh -c '[ -z "$MAINPID" ] || exec /usr/bin/crossfx --quit'
Restart=on-failure
RestartSec=3
Slice=session.slice

[Install]
WantedBy=graphical-session.target
