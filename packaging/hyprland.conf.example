# CrossFX on Hyprland ------------------------------------------------------
# The window is frameless and has a fixed design size (1040x588 for the Pro
# view, 550x189 for the Lite view - content plus the 56px title bar, the 1px
# divider and the 20px bottom pad), so let it float instead of tiling.
#
# Which spelling: Hyprland 0.53 rewrote window rules (hyprwm/Hyprland#12269):
# `windowrulev2` is gone — a config *error*, not a warning, and 0.54 and newer
# name it in the message — and a `windowrule` is a block keyed by name (or one
# line of `field value` pairs). `no_border` did not survive as a window-rule
# field, only as a workspace-rule one: a window rule spells it `border_size = 0`.
# Since 0.55 the hyprland.conf format is itself deprecated in favour of a Lua
# config, though it still parses; the Lua spelling is at the end. Every form
# in this file passes `Hyprland --verify-config` on 0.56.2.

windowrule {
    name = crossfx
    match:class = ^(io\.github\.blackixxce12\.CrossFX)$
    float = true
    border_size = 0
    rounding = 8
    # The original FxSound's window has no drop shadow; disable the compositor's to match it.
    no_shadow = true
}

# The same rule on one line, if you would rather not have a block:
# windowrule = match:class ^(io\.github\.blackixxce12\.CrossFX)$, float true, border_size 0, rounding 8, no_shadow true

# Hyprland 0.52 and older, where the keyword was still windowrulev2:
# windowrulev2 = float,        class:^(io\.github\.blackixxce12\.CrossFX)$
# windowrulev2 = noborder,     class:^(io\.github\.blackixxce12\.CrossFX)$
# windowrulev2 = rounding 8,   class:^(io\.github\.blackixxce12\.CrossFX)$
# windowrulev2 = noshadow,     class:^(io\.github\.blackixxce12\.CrossFX)$

# Settings, the changelog and the preset dialogs are panes inside the main window, so there
# are no extra toplevels to rule for. Fullscreen (e.g. `fullscreen` on Super+F) scales the
# window's fixed design up to fit the monitor.

# Global hotkeys ----------------------------------------------------------
# A Wayland client cannot grab global shortcuts the way the original FxSound
# for Windows does. Bind them in the compositor instead; each one is forwarded
# over CrossFX's control socket to the running instance, and none of them
# raises the window (only --toggle-window, --show and --view do); one that
# starts CrossFX starts it in the tray. The bind syntax has not changed.
# Super+Alt because few desktops and no applications use it: a compositor bind
# takes its keys from every application, and the original FxSound for
# Windows's own chords collide - Ctrl+Shift+Q, its power toggle, is how
# Chromium quits.
bind = SUPER ALT, P,            exec, crossfx --toggle-power
bind = SUPER ALT, W,            exec, crossfx --toggle-window
bind = SUPER ALT, bracketright, exec, crossfx --next-preset
bind = SUPER ALT, bracketleft,  exec, crossfx --prev-preset
bind = SUPER ALT, O,            exec, crossfx --next-output

# hyprland.lua (Hyprland 0.55 and newer) ----------------------------------
# The same rule and binds for the Lua config. The backslashes are doubled
# because a Lua string escapes them and the regex still needs them.
#
#   hl.window_rule({
#       match = { class = "^(io\\.github\\.blackixxce12\\.CrossFX)$" },
#       float = true, border_size = 0, rounding = 8, no_shadow = true,
#   })
#   hl.bind("SUPER + ALT + P", hl.dsp.exec_cmd("crossfx --toggle-power"))
#   hl.bind("SUPER + ALT + W", hl.dsp.exec_cmd("crossfx --toggle-window"))
#   hl.bind("SUPER + ALT + bracketright", hl.dsp.exec_cmd("crossfx --next-preset"))
#   hl.bind("SUPER + ALT + bracketleft", hl.dsp.exec_cmd("crossfx --prev-preset"))
#   hl.bind("SUPER + ALT + O", hl.dsp.exec_cmd("crossfx --next-output"))
